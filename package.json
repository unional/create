    "nuke": "pnpm clean && rimraf node_modules",
    "release": "changeset publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "pnpm lint && pnpm build && pnpm depcheck && pnpm coverage",
    "version": "changeset version",
    "watch": "pnpm test:watch"
  },
