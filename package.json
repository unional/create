{
	"name": "root",
	"version": "0.0.0-development",
	"private": true,
	"description": "@unional repository creation and management tools",
	"homepage": "https://github.com/unional/create",
	"bugs": {
		"url": "https://github.com/unional/create/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/unional/create.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"scripts": {
		"build": "tsc -b",
		"build:watch": "tsc -b -w",
		"clean": "pnpm -r run clean && rimraf .tsbuildinfo",
		"coverage": "vitest run --coverage",
		"cs": "changeset",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"nuke": "pnpm clean && rimraf node_modules",
		"release": "changeset publish",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "pnpm lint && pnpm build && pnpm coverage",
		"version": "changeset version",
		"watch": "pnpm test:watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^11.0.0",
		"@commitlint/config-conventional": "^11.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/ncp": "^2.0.4",
		"@types/node": "^24.0.0",
		"@types/ramda": "^0.27.38",
		"@types/tmp": "^0.2.0",
		"@types/update-notifier": "^5.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"global-store": "1.0.0-beta.21",
		"rimraf": "^6.0.0",
		"tmp": "^0.2.1",
		"typescript": "~7.0.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.20.0"
}
