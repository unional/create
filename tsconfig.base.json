{
	"compilerOptions": {
		"esModuleInterop": true,
		"lib": ["es2022"],
		"moduleResolution": "node16",
		"newLine": "LF",
		"noUnusedLocals": true,
		"outDir": ".nowhere",
		"removeComments": false,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src", "typings"]
}
